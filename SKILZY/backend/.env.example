# Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Secret key for JWT token signing (generate a strong random string)
SECRET_KEY=change-me-in-production

# JWT algorithm
ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Get these from Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# MongoDB Connection URL
# Format: mongodb://username:password@host:port/database
# For local development: mongodb://localhost:27017/skillzydb
MONGO_DATABASE_URL=mongodb://localhost:27017/skillzydb

# Frontend Base URL (for OAuth redirects)
# Used for redirecting after Google OAuth login
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated list of admin emails
ADMINS=admin@example.com
